<Window x:Class="TaskCapture.Windows.StageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Этапы · TaskCapture" Width="680" Height="620" MinWidth="560" MinHeight="450">
 <DockPanel Margin="30"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Твоя статусная модель" FontSize="28" FontWeight="Light"/><TextBlock Text="Назови этапы и отметь те, которые означают завершение." Style="{StaticResource MutedText}" Margin="0,12,0,24"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorLabel" Style="{StaticResource MutedText}" Margin="0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="+ Добавить этап" Click="Add_Click" Margin="0,0,8,0"/><Button Grid.Column="1" Content="Сохранить" Click="Save_Click" Margin="8,0,0,0"/></Grid></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="StageList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Locked}" MaxLength="40"/><CheckBox Grid.Column="1" Content="Завершён" IsChecked="{Binding IsDone}" IsEnabled="{Binding Editable}" Margin="16,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="×" Padding="12" IsEnabled="{Binding Editable}" Click="Delete_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel>
</Window>
