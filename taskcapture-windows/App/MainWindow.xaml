<Window x:Class="TaskCapture.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaskCapture Glass" Width="1180" Height="780" MinWidth="740" MinHeight="520" Closing="Window_Closing">
 <Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource GlassCard}" Padding="18,26"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="TC" FontSize="42" FontWeight="Light" Margin="12,0,0,4"/><TextBlock Text="TaskCapture" FontSize="19" Margin="12,0,0,6"/><TextBlock Text="Локальный бэклог" Style="{StaticResource MutedText}" Margin="12,0,0,28"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Background="#222D333E" CornerRadius="15" Padding="12" Margin="0,16,0,14"><StackPanel><TextBlock Text="ГОРЯЧАЯ КЛАВИША" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="HotkeyLabel" Text="Не настроена" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Button Content="Этапы задач" Click="Stages_Click" Margin="0,0,0,10"/><Button Content="Настройки" Click="Settings_Click"/><TextBlock x:Name="PathLabel" Style="{StaticResource MutedText}" FontSize="11" Margin="4,12,4,0" TextTrimming="CharacterEllipsis" MaxHeight="56"/></StackPanel>
   <ListBox x:Name="StageFilters" SelectionChanged="Filter_Changed"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Count}" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="2,2,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Мои задачи" FontSize="36" FontWeight="Light"/><TextBlock x:Name="SummaryLabel" Text="Всё важное — в одном месте" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel><Button Grid.Column="1" Content="Открыть MD ↗" Click="OpenFile_Click" VerticalAlignment="Top" Margin="16,8,0,0"/></Grid>
   <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,0,0,18"><TextBlock x:Name="HintLabel" Text="Выдели текст → нажми горячую клавишу → задача в бэклоге" Style="{StaticResource MutedText}" FontSize="13"/></Border>
   <ScrollViewer Grid.Row="2" x:Name="TaskScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><TextBlock x:Name="EmptyLabel" Text="Начни с настройки горячей клавиши и файла задач" Style="{StaticResource MutedText}" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="18"/><ItemsControl x:Name="TaskList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource GlassCard}" Margin="0,0,12,16" Loaded="Card_Loaded"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,12,12"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,20,14"/><TextBlock Text="{Binding ProcessingLabel}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Width="148"><ComboBox ItemsSource="{Binding Stages}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding StageId,Mode=OneWay}" SelectionChanged="TaskStage_Changed" AutomationProperties.Name="Статус задачи"/><Button Content="Открыть ↗" Click="Edit_Click" Margin="0,12,0,0"/><Button Content="Повторить" Click="Retry_Click" Visibility="{Binding RetryVisibility}" Margin="0,8,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></ScrollViewer>
   <TextBlock Grid.Row="3" x:Name="MessageLabel" Style="{StaticResource MutedText}" FontSize="12" Margin="2,14,0,0"/>
  </Grid>
 </Grid>
</Window>
