<Window x:Class="TaskCapture.Windows.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterScreen" Title="Настройки TaskCapture" Width="680" Height="760" MinWidth="580" MinHeight="540">
 <DockPanel Margin="30"><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorLabel" Foreground="{StaticResource Muted}" Margin="0,12"/><Button Content="Сохранить настройки" Click="Save_Click"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Твой способ сохранять задачи" FontSize="28" FontWeight="Light" Margin="0,0,0,12"/><TextBlock Text="Один файл. Одна горячая клавиша. Всё локально." Style="{StaticResource MutedText}" Margin="0,0,0,26"/>
 <TextBlock Text="Горячая клавиша" Margin="0,0,0,10"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown" AutomationProperties.Name="Горячая клавиша"/><TextBlock Text="Нажми сочетание в поле. Например Ctrl + Shift + T." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,24"/>
 <TextBlock Text="Файл с задачами" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PathBox" IsReadOnly="True" AutomationProperties.Name="MD-файл задач"/><Button Grid.Column="1" Content="Выбрать…" Click="Pick_Click" Margin="12,0,0,0"/></Grid><TextBlock Text="Можно создать новый MD или открыть файл TaskCapture. При смене файла прежние задачи остаются в прежнем файле." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,24"/>
 <TextBlock Text="Этапы задач · один на строку" Margin="0,0,0,10"/><TextBox x:Name="StagesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto"/><CheckBox x:Name="LastDone" Content="Последний этап означает завершённую задачу"/><TextBlock Text="Бэклог — обязательный первый этап. Названия и дополнительные этапы можно менять. Используемые этапы удалить нельзя." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,14"/><CheckBox x:Name="Autostart" Content="Запускать в трее при входе в Windows"/>
 </StackPanel></ScrollViewer></DockPanel>
</Window>
