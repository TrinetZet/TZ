<Window x:Class="TaskCapture.Windows.EditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" Title="Задача · TaskCapture" Width="740" Height="800" MinWidth="540" MinHeight="500" PreviewKeyDown="Window_KeyDown">
 <Grid Background="{StaticResource Backdrop}">
 <DockPanel Margin="30"><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorLabel" Style="{StaticResource MutedText}" Margin="0,14"/><Button x:Name="SaveButton" Content="Сохранить · Ctrl + Enter" Click="Save_Click"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="Содержание задачи" FontSize="30" FontWeight="Light"/><TextBlock x:Name="StageLabel" Style="{StaticResource MutedText}" Margin="0,10,0,28"/><TextBlock Text="Заголовок" Margin="0,0,0,10"/><TextBox x:Name="TitleBox" MaxLength="200" TextWrapping="Wrap" AutomationProperties.Name="Заголовок задачи"/><TextBlock Text="Описание" Margin="0,24,0,10"/><TextBox x:Name="DescriptionBox" MaxLength="4096" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Описание задачи"/><TextBlock Text="Исходный текст" Margin="0,24,0,10"/><TextBox x:Name="SourceBox" MaxLength="65536" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Исходный текст"/><TextBlock Text="После сохранения три текста сразу обновятся в твоём MD-файле." Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"/></StackPanel></ScrollViewer></DockPanel>
 </Grid>
</Window>
